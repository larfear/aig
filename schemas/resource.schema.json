{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aig.example.invalid/schemas/resource.schema.json",
  "title": "AIG resource 0.1 draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "publisher", "source", "revision", "status", "published_at", "updated_at", "synthetic", "representations"],
  "properties": {
    "schema_version": { "const": "aig-resource/0.1-draft" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "record_id"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "record_id": { "type": "string", "minLength": 1 },
        "public_url": { "type": "string", "format": "uri" }
      }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["published", "withdrawn"] },
    "published_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "synthetic": { "type": "boolean" },
    "withdrawal_reason": { "type": "string", "minLength": 1 },
    "representations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["media_type", "derivation"],
        "properties": {
          "media_type": { "type": "string", "minLength": 1 },
          "derivation": { "enum": ["original", "human_summary", "machine_summary", "transcript"] },
          "content_text": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        },
        "oneOf": [
          { "required": ["content_text"], "properties": { "content_text": { "type": "string" } } },
          { "required": ["url"], "properties": { "url": { "type": "string" } } }
        ]
      }
    },
    "extensions": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "published" } } },
      "then": { "properties": { "representations": { "type": "array", "minItems": 1 } } },
      "else": {
        "required": ["withdrawal_reason"],
        "properties": {
          "withdrawal_reason": { "type": "string", "minLength": 1 },
          "representations": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ]
}
