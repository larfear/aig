{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aig-local-environment",
  "main": "dev/worker.ts",
  // Match the locked workerd runtime; advance deliberately with dependency updates.
  "compatibility_date": "2026-10-12",
  "tsconfig": "tsconfig.worker.json",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aig-local",
      // Local placeholder only. No Cloudflare resource has been created.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": false
    }
  ]
}
