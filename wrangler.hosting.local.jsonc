{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aig-hosting-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-12",
  "tsconfig": "tsconfig.worker.json",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": { "AIG_CONTENT_MODE": "synthetic" },
  "dev": { "ip": "127.0.0.1", "port": 8787, "local_protocol": "http" },
  "d1_databases": [{
    "binding": "DB", "database_name": "aig-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "remote": false, "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
}
